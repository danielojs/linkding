# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans and crash logs
*.tfplan
tfplan
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Local Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Environment and local secret files
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
